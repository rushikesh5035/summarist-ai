
# APP
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000 
# add ngrok url here when testing webhooks locally, e.g. https://abc123.ngrok-free.app

NEXT_PUBLIC_DEMO_VIDEO_URL=https://your-vercel-blob-url.public.blob.vercel-storage.com/summarist-demo.mp4

# CLERK AUTHENTICATION
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# DATABASE (NeonDB)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# GOOGLE GEMINI AI
GEMINI_API_KEY=AIza...

# UPLOADTHING (FILE UPLOADS)
UPLOADTHING_TOKEN=...

# INNGEST (BACKGROUND JOBS)
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# POLAR PAYMENTS (SANDBOX - USED WHEN NODE_ENV IS NOT production)
POLAR_SANDBOX_ACCESS_TOKEN=...
POLAR_SANDBOX_WEBHOOK_SECRET=...
POLAR_SANDBOX_PRO_PRODUCT_ID=prod_...
POLAR_SANDBOX_UNLIMITED_PRODUCT_ID=prod_...

# POLAR PAYMENTS (PRODUCTION - USED WHEN NODE_ENV=production)
POLAR_ACCESS_TOKEN=...
POLAR_WEBHOOK_SECRET=...
POLAR_PRO_PRODUCT_ID=prod_...
POLAR_UNLIMITED_PRODUCT_ID=prod_...
